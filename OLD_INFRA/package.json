    "@types/luxon": "^3.2.0",
    "@types/node": "18.x",
    "@types/uuid": "^9.0.0",
    "@types/yargs": "^17.0.23",
    "@typescript-eslint/eslint-plugin": "^5.50.0",
    "@typescript-eslint/parser": "^5.50.0",
    "@vitest/coverage-c8": "^0.28.5",
    "@vitest/coverage-istanbul": "^0.28.5",
    "@vitest/ui": "^0.28.5",
    "copyfiles": "^2.4.1",
    "eslint": "^8.33.0",
